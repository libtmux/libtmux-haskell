source-repository head
  type: git
  location: https://github.com/libtmux/libtmux-haskell

common modern
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    NoFieldSelectors
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns
  build-depends: base >=4.22 && <4.23

benchmark capture
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Capture.hs
  ghc-options: -threaded -rtsopts
  build-depends:
    filepath >=1.5.4 && <1.6,
    libtmux-haskell

library
  import: modern
  hs-source-dirs: src internal
  exposed-modules: LibTmux LibTmux.Server LibTmux.Snapshot LibTmux.Snapshot.Fixture LibTmux.Id LibTmux.Value LibTmux.Version
    LibTmux.Query LibTmux.Query.Pane LibTmux.Query.Session LibTmux.Query.Window
    LibTmux.Query.Link LibTmux.Query.Occurrence LibTmux.Query.Client
    LibTmux.Query.ClientAttachment LibTmux.Query.ServerInfo
  other-modules: LibTmux.Internal.Mutation LibTmux.Internal.Command LibTmux.Internal.Query LibTmux.Internal.Scope LibTmux.Internal.Capture LibTmux.Internal.Topology LibTmux.Internal.Entropy LibTmux.Internal.Runtime LibTmux.Internal.Budget LibTmux.Internal.Scheduler LibTmux.Internal.Frame LibTmux.Internal.TmuxText LibTmux.Internal.Field LibTmux.Internal.Record LibTmux.Internal.Graph LibTmux.Internal.SocketPin LibTmux.Internal.Process LibTmux.Internal.Process.Native
  c-sources: cbits/process.c
  include-dirs: cbits
  cc-options: -std=c11 -Wall -Wextra
  extra-libraries: dl
  if !os(linux)
    buildable: False
  build-depends:
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    directory >=1.3.10 && <1.4,
    filepath >=1.5.4 && <1.6,
    os-string >=2.0.8 && <2.1,
    stm >=2.5.3 && <2.6,
    text >=2.1.3 && <2.2,
    time >=1.15 && <1.16,
    unix >=2.8.8 && <2.9

test-suite specs
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: test/specs
  main-is: Main.hs
  other-modules: IdSpec IdProperties ValueSpec VersionSpec FixtureSpec
  ghc-options: -threaded -rtsopts
  build-depends:
    libtmux-haskell,
    hspec >=2.11.18 && <2.12,
    os-string >=2.0.8 && <2.1,
    QuickCheck >=2.19 && <2.20,
    text >=2.1.3 && <2.2

test-suite unit
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: test internal
  main-is: Main.hs
  other-modules: CommandTest LibTmux.Internal.Command QueryTest QueryFixture QueryProperties LibTmux.Internal.Query RecordTest FieldTest SchedulerTest BudgetTest FrameTest GraphTest GraphProperties TopologyTest LibTmux.Internal.Topology LibTmux.Internal.Scheduler LibTmux.Internal.Budget LibTmux.Internal.Frame LibTmux.Internal.TmuxText LibTmux.Internal.Field LibTmux.Internal.Record LibTmux.Internal.Graph
  ghc-options: -threaded -rtsopts
  build-depends:
    libtmux-haskell,
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    filepath >=1.5.4 && <1.6,
    os-string >=2.0.8 && <2.1,
    stm >=2.5.3 && <2.6,
    tasty >=1.5.5 && <1.6,
    tasty-hunit >=0.10.2 && <0.11,
    tasty-quickcheck >=0.11.1 && <0.12,
    QuickCheck >=2.19 && <2.20,
    text >=2.1.3 && <2.2

test-suite integration
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: test/integration test-support internal
  main-is: Main.hs
  other-modules: PublicMutationTest RuntimeMutationTest CommandIntegrationTest LibTmux.Internal.Mutation LibTmux.Internal.Command PublicServerTest ScopeTest LibTmux.Internal.Scope EntityCaptureTest LibTmux.Internal.Capture LibTmux.Internal.Topology LibTmux.Internal.Entropy RuntimeTest RuntimeReadTest LibTmux.Internal.Runtime Fixture FixtureTest FrameIntegrationTest SocketPinTest ProcessTest ProcessGate LibTmux.Internal.Budget LibTmux.Internal.Scheduler LibTmux.Internal.Frame LibTmux.Internal.TmuxText LibTmux.Internal.Field LibTmux.Internal.Record LibTmux.Internal.Graph LibTmux.Internal.SocketPin LibTmux.Internal.Process LibTmux.Internal.Process.Native
  c-sources: test-support/fixture-watch.c test-support/process-gate.c cbits/process.c
  include-dirs: cbits
  extra-libraries: dl
  cc-options: -std=c11 -Wall -Wextra
  ghc-options: -threaded -rtsopts -optl-Wl,--wrap=libtmux_process_write
  if !os(linux)
    buildable: False
  build-depends:
    libtmux-haskell,
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    directory >=1.3.10 && <1.4,
    filepath >=1.5.4 && <1.6,
    os-string >=2.0.8 && <2.1,
    stm >=2.5.3 && <2.6,
    tasty >=1.5.5 && <1.6,
    tasty-hunit >=0.10.2 && <0.11,
    text >=2.1.3 && <2.2,
    typed-process >=0.2.13 && <0.3,
    QuickCheck >=2.19 && <2.20,
    unix >=2.8.8 && <2.9
