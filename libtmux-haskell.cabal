cabal-version: 3.18
name: libtmux-haskell
version: 0.1.0.0
synopsis: Typed tmux IDs, checked values and release admission
description:
  Distinct entity IDs, checked dimensions and indices, and stable-release
  parsing. These pure values do not contact tmux. Native client, observation
  and command APIs remain under development.
license: MIT
license-file: LICENSE
author: libtmux contributors
maintainer: https://github.com/libtmux/libtmux-haskell/issues
category: System
homepage: https://github.com/libtmux/libtmux-haskell
bug-reports: https://github.com/libtmux/libtmux-haskell/issues
build-type: Simple
tested-with: GHC ==9.14.1
extra-doc-files:
  README.md
  docs/assets/*.svg
  docs/assets/*.png
  docs/assets/*.jpg
  docs/assets/*.ico
  docs/assets/*.json
  docs/assets/*.webmanifest
  docs/assets/*.xml
  docs/branding.md
  AGENTS.md
  .github/CONTRIBUTING.md
  .github/WRITING.md
  .github/TESTING.md
  docs/README.md
  docs/installation.md
  docs/values.md
  docs/api.md
  docs/status.md
  docs/contracts/README.md
  docs/contracts/environment.md
  docs/contracts/observations.md
  docs/contracts/interactive.md
  docs/contracts/creation.md
  docs/contracts/options-hooks.md
  docs/contracts/buffers-config.md
  docs/contracts/framing.md
  docs/contracts/socket-pin.md
  docs/contracts/acquisition.md
  docs/contracts/pane-commands.md
extra-source-files:
  .tool-versions
  docs/contracts/python.json
  docs/contracts/traceability.json
  scripts/check-types
  scripts/check_sdist.py
  scripts/check_docs.py
  scripts/test_check_docs.py
  examples/catalogue.json
  examples/typed-values/Main.hs
  examples/typed-values/expected.stdout
  examples/typed-values/libtmux-typed-values.cabal
  examples/typed-values/cabal.project
  examples/typed-values/cabal.project.vcs
  scripts/ci_tmux.py
  scripts/test_ci_tmux.py
  .github/tmux-releases.json
  .github/workflows/ci.yml
  .github/dependabot.yml
  test/compile-pass/*.hs
  test/compile-fail/*.hs

source-repository head
  type: git
  location: https://github.com/libtmux/libtmux-haskell

common modern
  default-language: GHC2024
  default-extensions:
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    NoFieldSelectors
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns
  build-depends: base >=4.22 && <4.23

library
  import: modern
  hs-source-dirs: src internal
  exposed-modules: LibTmux.Id LibTmux.Value LibTmux.Version
  other-modules: LibTmux.Internal.Frame LibTmux.Internal.Graph LibTmux.Internal.SocketPin
  build-depends:
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    directory >=1.3.10 && <1.4,
    filepath >=1.5.4 && <1.6,
    stm >=2.5.3 && <2.6,
    text >=2.1.3 && <2.2,
    time >=1.15 && <1.16,
    typed-process >=0.2.13 && <0.3,
    unix >=2.8.8 && <2.9

test-suite specs
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: test/specs
  main-is: Main.hs
  other-modules: IdSpec IdProperties ValueSpec VersionSpec
  ghc-options: -threaded -rtsopts
  build-depends:
    libtmux-haskell,
    hspec >=2.11.18 && <2.12,
    QuickCheck >=2.19 && <2.20,
    text >=2.1.3 && <2.2

test-suite unit
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: test internal
  main-is: Main.hs
  other-modules: FrameTest GraphTest GraphProperties LibTmux.Internal.Frame LibTmux.Internal.Graph
  ghc-options: -threaded -rtsopts
  build-depends:
    libtmux-haskell,
    bytestring >=0.12.2 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    tasty >=1.5.5 && <1.6,
    tasty-hunit >=0.10.2 && <0.11,
    tasty-quickcheck >=0.11.1 && <0.12,
    QuickCheck >=2.19 && <2.20,
    text >=2.1.3 && <2.2

test-suite integration
  import: modern
  type: exitcode-stdio-1.0
  hs-source-dirs: test/integration test-support internal
  main-is: Main.hs
  other-modules: Fixture FixtureTest FrameIntegrationTest SocketPinTest LibTmux.Internal.Frame LibTmux.Internal.Graph LibTmux.Internal.SocketPin
  c-sources: test-support/fixture-watch.c
  cc-options: -std=c11 -Wall -Wextra
  ghc-options: -threaded -rtsopts
  if !os(linux)
    buildable: False
  build-depends:
    libtmux-haskell,
    async >=2.2.6 && <2.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.8 && <0.9,
    deepseq >=1.5.1 && <1.6,
    directory >=1.3.10 && <1.4,
    filepath >=1.5.4 && <1.6,
    os-string >=2.0.8 && <2.1,
    tasty >=1.5.5 && <1.6,
    tasty-hunit >=0.10.2 && <0.11,
    text >=2.1.3 && <2.2,
    typed-process >=0.2.13 && <0.3,
    unix >=2.8.8 && <2.9
