cabal-version: 3.18
name: libtmux-offline-graph
version: 0.0.0
build-type: Simple
license: MIT
extra-doc-files: README.md

executable offline-graph
  main-is: Main.hs
  default-language: GHC2024
  ghc-options: -Wall -Werror
  build-depends:
    base >=4.22 && <4.23,
    libtmux-haskell ^>=0.0.1.0,
    os-string >=2.0.8 && <2.1
