cabal-version: 3.18
name: libtmux-create-session
version: 0.0.0
build-type: Simple
license: MIT
extra-doc-files: README.md

executable create-session
  main-is: Main.hs
  default-language: GHC2024
  ghc-options: -Wall -Werror
  build-depends:
    base >=4.22 && <4.23,
    filepath >=1.5.4 && <1.6,
    libtmux-haskell ^>=0.1.0.0,
    os-string >=2.0.8 && <2.1,
    text >=2.1.3 && <2.2
