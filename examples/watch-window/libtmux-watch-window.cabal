cabal-version: 3.18
name: libtmux-watch-window
version: 0.0.0
build-type: Simple
license: MIT
extra-doc-files: README.md

executable watch-window
  main-is: Main.hs
  default-language: GHC2024
  ghc-options: -Wall -Werror
  build-depends:
    base >=4.22 && <4.23,
    bytestring >=0.12.2 && <0.13,
    libtmux-haskell ^>=0.0.1.0,
    stm >=2.5.3 && <2.6
