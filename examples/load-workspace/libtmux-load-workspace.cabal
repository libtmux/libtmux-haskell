cabal-version: 3.18
name: libtmux-load-workspace
version: 0.0.0
build-type: Simple
license: MIT
extra-doc-files: README.md

executable load-workspace
  main-is: Main.hs
  default-language: GHC2024
  ghc-options: -Wall -Werror
  build-depends:
    base >=4.22 && <4.23,
    bytestring >=0.12.2 && <0.13,
    directory >=1.3.10 && <1.4,
    libtmux-haskell ^>=0.0.1.0,
    libtmux-haskell-workspace ^>=0.0.1.0,
    text >=2.1.3 && <2.2
