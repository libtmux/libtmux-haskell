cabal-version: 3.18
name: libtmux-managed-program
version: 0.0.0
build-type: Simple
license: MIT
extra-doc-files: README.md

executable managed-program
  main-is: Main.hs
  default-language: GHC2024
  ghc-options: -Wall -Werror
  build-depends:
    async >=2.2.6 && <2.3,
    base >=4.22 && <4.23,
    bytestring >=0.12.2 && <0.13,
    filepath >=1.5.4 && <1.6,
    libtmux-haskell ^>=0.0.1.0,
    os-string >=2.0.8 && <2.1
